# ---- Agenda de demos (/agendar) ----
# Copiar a .env para desarrollo local. En producción, cargar en Vercel (Settings → Environment Variables).

# Credenciales OAuth de Google Cloud (tipo "Aplicación web"). Ver AGENDAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene una vez con:  bun scripts/google-auth.js
GOOGLE_REFRESH_TOKEN=
# Calendario donde caen las demos. "primary" = el calendario principal de la cuenta autorizada.
GOOGLE_CALENDAR_ID=primary

# Sin GOOGLE_REFRESH_TOKEN, o con esto en "simulada", la agenda muestra todos los turnos libres
# y no crea eventos reales (para desarrollar / probar la pantalla).
AGENDA_MODO=simulada

# Casilla desde la que salen la confirmación al prospecto y el aviso interno (info@digitalimpulso.com).
# El prospecto sólo ve este remitente; nunca la cuenta de Google del calendario.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Digital Impulso <info@digitalimpulso.com>
# A quién le llega el aviso interno de cada demo agendada, ADEMÁS de la casilla SMTP_USER.
# Varios separados por coma.
AGENDA_AVISO_EMAIL=cflopez.86@gmail.com

# Opcional: cada reserva se manda como POST JSON acá (monday, Google Sheets, Make, n8n…).
LEAD_WEBHOOK_URL=

# Reglas (todas opcionales; estos son los valores por defecto)
# AGENDA_DURACION_MIN=30
# AGENDA_PASO_MIN=30
# AGENDA_BUFFER_MIN=15
# AGENDA_HORA_INICIO=10:00
# AGENDA_HORA_FIN=17:00
# AGENDA_DIAS_HABILES=1,2,3,4,5
# AGENDA_ANTICIPACION_MIN=180
# AGENDA_DIAS_MAX=21
# AGENDA_TITULO=Demo Digital Impulso
